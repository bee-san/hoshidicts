set(GIT_COMMIT "unknown")
set(GIT_DIRTY 0)

if(GIT_EXECUTABLE AND EXISTS "${GIT_EXECUTABLE}")
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        RESULT_VARIABLE GIT_COMMIT_RESULT
        OUTPUT_VARIABLE GIT_COMMIT_OUTPUT
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
    )
    if(GIT_COMMIT_RESULT EQUAL 0 AND GIT_COMMIT_OUTPUT)
        set(GIT_COMMIT "${GIT_COMMIT_OUTPUT}")
    endif()

    execute_process(
        COMMAND "${GIT_EXECUTABLE}" status --porcelain
        WORKING_DIRECTORY "${SOURCE_DIR}"
        RESULT_VARIABLE GIT_STATUS_RESULT
        OUTPUT_VARIABLE GIT_STATUS_OUTPUT
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
    )
    if(GIT_STATUS_RESULT EQUAL 0 AND GIT_STATUS_OUTPUT)
        set(GIT_DIRTY 1)
    endif()
endif()

get_filename_component(OUTPUT_DIRECTORY "${OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")

set(HEADER_CONTENT
"#pragma once

#define HOSHIDICTS_BENCHMARK_GIT_COMMIT \"${GIT_COMMIT}\"
#define HOSHIDICTS_BENCHMARK_GIT_DIRTY ${GIT_DIRTY}
")
string(RANDOM LENGTH 8 TEMP_SUFFIX)
set(TEMP_FILE "${OUTPUT_FILE}.${TEMP_SUFFIX}.tmp")
file(WRITE "${TEMP_FILE}" "${HEADER_CONTENT}")
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${TEMP_FILE}" "${OUTPUT_FILE}"
    COMMAND_ERROR_IS_FATAL ANY
)
file(REMOVE "${TEMP_FILE}")
