{
  "comment": "Yomitan's Yiddish text processors (ext/js/language/yi/yiddish-text-preprocessors.js and yiddish-text-postprocessors.js at d3c54c1, GPL-3.0-or-later, Copyright (C) 2024-2026 Yomitan Authors) written as pack processors (docs/languages.md 6). String.replace with a string replaces the first occurrence, so each ligature is one map step with at: first, in Yomitan's list order. sources/scratch-pack.mjs puts them into a copy of the pack for tools/check-yomitan.mjs and the measurements.",
  "preprocessors": [
    {
      "id": "removeYiddishDiacritics",
      "name": "Remove diacritics",
      "keepInput": false,
      "variants": [[{"strip": "[\\u05B0-\\u05C7]"}]]
    },
    {
      "id": "combineYiddishLigatures",
      "name": "Combine ligatures",
      "keepInput": false,
      "variants": [[
        {"map": {"\u05D5\u05D5": "\u05F0"}, "at": "first"},
        {"map": {"\u05D5\u05D9": "\u05F1"}, "at": "first"},
        {"map": {"\u05D9\u05D9": "\u05F2"}, "at": "first"},
        {"map": {"\u05D9\u05B4": "\uFB1D"}, "at": "first"},
        {"map": {"\u05D9\u05D9\u05B7": "\uFB1F"}, "at": "first"},
        {"map": {"\u05D0\u05B7": "\uFB2E"}, "at": "first"},
        {"map": {"\u05D0\u05B8": "\uFB2F"}, "at": "first"}
      ]]
    }
  ],
  "postprocessors": [
    {
      "id": "convertFinalLetters",
      "name": "Convert to final letters",
      "keepInput": false,
      "variants": [[{"map": {"\u05DE": "\u05DD", "\u05E0": "\u05DF", "\u05E6": "\u05E5", "\u05E4": "\u05E3", "\u05DB": "\u05DA"}, "at": "end"}]]
    },
    {
      "id": "convertYiddishLigatures",
      "name": "Split and combine ligatures",
      "variants": [
        [
          {"map": {"\u05F0": "\u05D5\u05D5"}, "at": "first"},
          {"map": {"\u05F1": "\u05D5\u05D9"}, "at": "first"},
          {"map": {"\u05F2": "\u05D9\u05D9"}, "at": "first"},
          {"map": {"\uFB1D": "\u05D9\u05B4"}, "at": "first"},
          {"map": {"\uFB1F": "\u05D9\u05D9\u05B7"}, "at": "first"},
          {"map": {"\uFB2E": "\u05D0\u05B7"}, "at": "first"},
          {"map": {"\uFB2F": "\u05D0\u05B8"}, "at": "first"}
        ],
        [
          {"map": {"\u05D5\u05D5": "\u05F0"}, "at": "first"},
          {"map": {"\u05D5\u05D9": "\u05F1"}, "at": "first"},
          {"map": {"\u05D9\u05D9": "\u05F2"}, "at": "first"},
          {"map": {"\u05D9\u05B4": "\uFB1D"}, "at": "first"},
          {"map": {"\u05D9\u05D9\u05B7": "\uFB1F"}, "at": "first"},
          {"map": {"\u05D0\u05B7": "\uFB2E"}, "at": "first"},
          {"map": {"\u05D0\u05B8": "\uFB2F"}, "at": "first"}
        ]
      ]
    }
  ]
}
