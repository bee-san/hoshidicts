      "rare": ["vesperto", "karoto", "formiko", "pinglo", "mevo", "lacerto", "morbilo", "hufumo", "melongeno", "vipuro"]
    },
    "recommendedDictionaries": [
      {
        "name": "Wiktionary Esperanto-English (wiktionary-to-yomitan)",
        "url": "https://yomidevs.github.io/wiktionary-to-yomitan/download/",
        "description": "Esperanto words with English definitions from English Wiktionary, with inflected forms.",
        "licence": "CC BY-SA 4.0"
      }
    ],
    "sample": {
      "warmup": "legante",
      "practice": {
        "text": "Hieraŭ ni manĝis en malgranda restoracio apud la haveno.",
        "lookup": "manĝis"
      },
