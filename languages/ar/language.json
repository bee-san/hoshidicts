        "adv": "Adverb",
        "name": "Proper noun",
        "pron": "Pronoun",
        "prep": "Preposition",
        "conj": "Conjunction",
        "intj": "Interjection",
        "num": "Numeral",
        "det": "Determiner",
        "phrase": "Phrase",
        "prov": "Proverb"
      }
    },
    "frequencySamples": null,
    "recommendedDictionaries": [
      {
        "name": "wty-ar-en (wiktionary-to-yomitan)",
        "url": "https://github.com/yomidevs/wiktionary-to-yomitan",
        "description": "Arabic-English definitions from Wiktionary, with vowelled readings and the inflected forms of each word.",
        "licence": "CC BY-SA 4.0"
      }
    ],
    "sample": {
