            }
          ]
        ]
      },
      {
        "id": "normalizeLetterForms",
        "name": "Lunate sigma and letter symbols to plain letters",
        "keepInput": false,
        "variants": [
          [
            {
              "map": {
                "ϲ": "σ",
                "Ϲ": "Σ",
                "ϐ": "β",
                "ϑ": "θ",
                "ϕ": "φ",
                "ϖ": "π",
